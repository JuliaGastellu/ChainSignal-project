# Ejemplo de configuración local de ChainSignal. No contiene secretos.
#
# Copio este archivo a .env y completo solo lo que necesito. .env está en
# .gitignore y nunca lo versiono. Los valores marcados <...> son marcadores:
# los reemplazo por valores propios generados localmente.
#
# Docker Compose carga .env en api, worker, web y (con el perfil experimento)
# wdk. En api y worker vacío la seed y el token WDK aunque estén aquí.

# --- Aplicación -------------------------------------------------------------
# READ_ONLY (por defecto): la API y el worker no firman ni envían nada y no
# necesitan seed, token WDK ni destino de rescate.
# TESTNET_EXPERIMENT: solo para experiments/ en Sepolia; nunca con
# APP_ENV=production.
CHAINSIGNAL_MODE=READ_ONLY
APP_ENV=local
PORT=8001
WEB_PORT=8081
API_URL=http://127.0.0.1:8001
ENABLE_CACHE=true
AGENT_DEMO_MODE=false
# Intervalo del loop de monitoreo y TTL de caché, en segundos.
MONITOR_INTERVAL=20
CACHE_TTL=300

# --- Sesiones e identidad (E02) ----------------------------------------------
# Ya no existe una clave global de API: cada persona inicia sesión y la API
# autoriza por organización y rol. Creo la primera organización con:
#   python -m identidad.cli crear-organizacion --nombre "Mi equipo" --email yo@ejemplo.com
SESSION_TTL_HOURS=12
INVITATION_TTL_HOURS=72
# Secure por defecto. Los navegadores aceptan cookies Secure en http://localhost.
SESSION_COOKIE_SECURE=true
# Orígenes del navegador autorizados (CORS con credenciales y chequeo de Origin).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
EVENT_STREAM_POLL_SECONDS=2

# --- Solo para CHAINSIGNAL_MODE=TESTNET_EXPERIMENT ---------------------------
# En READ_ONLY los dejo vacíos.
WDK_SERVICE_TOKEN=
# Destino de transferencias protectoras del experimento. Nunca la dirección
# nula ni la de quema; una dirección de prueba que controlo.
SAFE_WALLET_ADDRESS=

# --- Base de datos -----------------------------------------------------------
# Vacía: SQLite temporal solo para desarrollo. Compose la reemplaza por el
# servicio Postgres `db`. El esquema se aplica con migraciones (alembic upgrade
# head); la API y el worker las corren al arrancar.
DATABASE_URL=
# Operación (E08). En producción DATABASE_URL es obligatoria (PostgreSQL) y
# DB_AUTO_MIGRATE=false: migro con `alembic upgrade head` como paso aparte.
DB_AUTO_MIGRATE=true
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
# Token para leer /metrics desde la red interna. Vacío: /metrics no existe.
METRICS_TOKEN=

# --- Red y proveedores de lectura (infra/red.py) -----------------------------
# El producto lee Ethereum mainnet (CHAIN_ID=1); READ_ONLY rechaza testnets.
# Cada proveedor verifica eth_chainId al conectar y no mezcla redes.
CHAIN_ID=1
ETHERSCAN_API_KEY=
# RPC de mainnet de solo lectura. Fija el balance al bloque de referencia y lo
# necesito para leer posiciones de Aave V3 (eth_call). Sin él, las posiciones
# responden UNAVAILABLE (not_configured). Para bloques antiguos hace falta archive.
ETHEREUM_RPC_URL=

# --- Ingesta (E03) -----------------------------------------------------------
INGESTION_CACHE_TTL_SECONDS=60
INGESTION_CONFIRMATIONS=12
INGESTION_REORG_DEPTH=64
INGESTION_PAGE_SIZE=1000
INGESTION_MAX_PAGES=20
INGESTION_MAX_RETRIES=3
PROVIDER_TIMEOUT_SECONDS=15

# --- Worker y notificaciones (E05) -------------------------------------------
WORKER_LEASE_SECONDS=60
WORKER_POLL_SECONDS=5
WORKER_MAX_ATTEMPTS=5
# Apagado por defecto: el canal sandbox guarda entregas en la base y no envía nada.
NOTIFICATIONS_WEBHOOKS_ENABLED=false
MAX_EVENT_STREAMS_PER_ORG=10

# --- Experiencia comercial (E06) ---------------------------------------------
# Alta autoservicio de organización y persona owner. Apagada por defecto.
SIGNUP_ENABLED=false
# Demo aislada con datos sintéticos; vence sola.
DEMO_ENABLED=true
DEMO_TTL_HOURS=24
# Solo desarrollo y E2E: reproduce la lectura Aave V3 desde una fixture grabada
# en lugar de consultar el RPC. Prohibido con APP_ENV=production.
AAVE_REPLAY_FIXTURE=

# --- Piloto comercial (E09) ------------------------------------------------------
# Cobro asistido: sin secreto, el webhook de facturación no existe (404).
BILLING_WEBHOOK_SECRET=
BILLING_PROVIDER=processor
# Formulario de contacto de la landing (guarda pedidos con consentimiento).
CONTACT_ENABLED=true

# --- Explicación opcional con modelo (E07) --------------------------------------
# Apagada: sin modelo el producto usa la plantilla determinista. Si la habilito,
# necesito una API compatible con chat completions, precios por millón de tokens
# para acotar el costo y un presupuesto diario por organización. La clave solo
# la lee la API; nunca la paso al worker ni a los experimentos.
EXPLANATION_MODEL_ENABLED=false
EXPLANATION_API_BASE=
# Clave del proveedor del modelo; solo la API la lee.
EXPLANATION_API_KEY=
EXPLANATION_MODEL=
EXPLANATION_TIMEOUT_SECONDS=15
EXPLANATION_MAX_OUTPUT_TOKENS=600
EXPLANATION_PRICE_INPUT_USD_PER_MTOK=
EXPLANATION_PRICE_OUTPUT_USD_PER_MTOK=
EXPLANATION_DAILY_BUDGET_USD=1

# --- Solo experimentos en Sepolia --------------------------------------------
SEPOLIA_RPC_URL=
SEPOLIA_CHAIN_ID=11155111

# --- Redacción opcional con LLM ----------------------------------------------
# Vacía: el motor usa su explicación determinística.
OPENAI_API_KEY=

# --- Experimento x402 en Sepolia (heredado) ----------------------------------
X402_ENABLED=true
X402_CHAIN_NAME=sepolia
X402_REPORT_PRICE_USDC=1
X402_PAYMENT_RECIPIENT=
USDC_ADDRESS_SEPOLIA=0x1C7D4b196cB0232491C26109653A6c6224a3383D

# --- Capa de seguridad de ejecución (experimento testnet) --------------------
MAX_EXPOSURE_ETH=0.5
COOLDOWN_SECONDS=300
SWAP_AMOUNT_WEI=500000000000000
DEMO_FORCE_TRANSFER_WEI=1000000000000000
DEMO_SIMULATED_MOVED_ETH=0.001

# --- Microservicio WDK (experimento de firma en testnet) ---------------------
# Fuera del alcance comercial de solo lectura. Nunca uso aquí una seed con
# fondos reales; si la completo, es una seed de prueba sin valor.
WDK_PORT=3001
WDK_URL=http://localhost:3001
WDK_NETWORK=sepolia
WDK_RPC_URL=
WDK_BUNDLER_URL=
WDK_PAYMASTER_URL=
WDK_SWAP_MAX_FEE=200000000000000
AGENT_SEED_PHRASE=
